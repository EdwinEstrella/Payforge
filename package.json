{
  "name": "payforge",
  "version": "1.0.6",
  "description": "Payforge Desktop App",
  "author": "Edwin",
  "main": "main.js",
  "build": {
    "appId": "com.edwin.payforge",
    "productName": "Payforge",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "files": [
      "**/*",
      ".env",
      "!.git/**/*",
      "!Diseño plantilla/**/*",
      "!.gemini/**/*",
      "!release/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "logo_blanco_negro.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "logo_blanco_negro.ico",
      "uninstallerIcon": "logo_blanco_negro.ico",
      "installerHeaderIcon": "logo_blanco_negro.ico",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EdwinEstrella",
        "repo": "Payforge",
        "releaseType": "release",
        "vPrefixedTagName": true
      }
    ]
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "release:win": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-wix": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@insforge/cli": "^0.1.81",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "stripe": "^22.1.0"
  }
}
